{
  "name": "dsh-collab",
  "version": "0.6.5",
  "private": true,
  "type": "module",
  "description": "DSH 多人协作研究室：邀请链接/二维码把朋友拉进你的项目，各自用自己的 token，互相能看到对方的进展流与成果文件；支持局域网与跨网段公网隧道，自带离线二维码与实验台。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "collaboration",
    "multiplayer",
    "pair-programming",
    "cloudflared",
    "qrcode"
  ],
  "license": "MIT",
  "author": "videndi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/videndi/dsh-collab.git"
  },
  "homepage": "https://github.com/videndi/dsh-collab#readme",
  "bugs": {
    "url": "https://github.com/videndi/dsh-collab/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./qr": "./qr.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "qr.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "scripts/*.mjs"
  ],
  "scripts": {
    "lab": "node scripts/lab.mjs",
    "tunnel": "node scripts/tunnel-check.mjs",
    "selftest": "node scripts/selftest.mjs",
    "relay": "node scripts/relay-server.mjs",
    "relay:check": "node scripts/relay-check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "engines": {
      "dsh": ">=0.2.1-rc.1"
    }
  }
}
